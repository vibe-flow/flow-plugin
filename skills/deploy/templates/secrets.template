#!/usr/bin/env bash
# Kamal v2 — secrets resolus a chaque deploiement. Les valeurs vivent dans
# Bitwarden Secrets Manager ; ce fichier est versionne et n'en contient aucune,
# seulement ou aller les chercher. Les UUID des projets sont dans .flow/project.json.
#
# ⚠️ Kamal relit ce fichier a la dotenv et interpole les `$` : un secret qui en
# contient arrive tronque. L'encoder en base64 cote BSM et le decoder dans l'app.
#
# Pre-requis : kamal, bws, jq ; BWS_ACCESS_TOKEN exporte (~/.zshrc).

set -euo pipefail

: "${BWS_ACCESS_TOKEN:?BWS_ACCESS_TOKEN manquant - export-le dans ~/.zshrc}"

# Identifiants du registry, communs a tous les projets.
BWS_SHARED_PROJECT_ID="$(jq -er '.bws.shared_project_id' .flow/project.json)"
SECRETS_SHARED=$(kamal secrets fetch --adapter bitwarden-sm "${BWS_SHARED_PROJECT_ID}/all")
REGISTRY_USER=$(kamal secrets extract REGISTRY_USER ${SECRETS_SHARED})
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS_SHARED})

# --- BLOC API : a retirer pour un projet sans API ---
# Secrets propres a l'app : une ligne `extract` par secret consomme.
BWS_PROJECT_ID="$(jq -er '.bws.project_id' .flow/project.json)"
SECRETS=$(kamal secrets fetch --adapter bitwarden-sm "${BWS_PROJECT_ID}/all")
DATABASE_URL=$(kamal secrets extract DATABASE_URL ${SECRETS})
REDIS_URL=$(kamal secrets extract REDIS_URL ${SECRETS})
JWT_SECRET=$(kamal secrets extract JWT_SECRET ${SECRETS})
JWT_REFRESH_SECRET=$(kamal secrets extract JWT_REFRESH_SECRET ${SECRETS})
